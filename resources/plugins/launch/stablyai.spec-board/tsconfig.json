{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "jsxImportSource": "orca",
    "lib": ["ES2022", "DOM"],
    "preserveSymlinks": true,
    "skipLibCheck": true,
    "typeRoots": ["../../../../node_modules/@types"],
    "types": ["node"]
  },
  "include": [
    "src",
    "../../declarative/orca.d.ts",
    "../../declarative/orca-components.d.ts",
    "../../declarative/orca-components-layout.d.ts",
    "../../declarative/orca-components-data.d.ts",
    "../../types/orca-frame.d.ts",
    "../../types/orca-host.d.ts",
    "../../types/orca-services.d.ts",
    "../../types/orca-testing.d.ts",
    "../../types/orca-worker.d.ts"
  ]
}
