# 复制成 .env 后填入真实值。.env 永远不进版本库。
#
# 生成两个密钥（各 32 字节随机）：
#   openssl rand -base64 48
#
# ORCA_AUTH_SESSION_COOKIE_SECRET 至少 32 字符；
# ORCA_RELAY_ASSIGNMENT_SIGNING_KEY 至少 32 字节随机串。

# 账号服务对外地址。必须是规范 origin（无路径、无尾斜杠），且与桌面端的 ORCA_CLOUD_API_URL 一致。
ORCA_AUTH_PUBLIC_URL=https://orca.ctjt.cn

# relay 对外地址。director 与 cell 可以同源。
ORCA_RELAY_PUBLIC_URL=https://orca.ctjt.cn
ORCA_RELAY_CELL_URL=https://c1.orca.ctjt.cn

# JWT issuer：relay 验签时必须与 auth 签发时逐字相等。
ORCA_RELAY_AUTH_ISSUER=https://orca.ctjt.cn
ORCA_RELAY_ADMIN_AUDIENCE=https://orca.ctjt.cn

# 首次启动播种的账号。密码若不给，服务端会生成随机密码并写到
# data/auth/orca-auth-bootstrap-credentials.json（0600）。
ORCA_AUTH_BOOTSTRAP_USER_EMAIL=operator@example.com

# relay 的两个服务账号，用于把部署动作与运行时动作分开记账。
ORCA_RELAY_DEPLOY_SERVICE_ACCOUNT=deploy@example.com
ORCA_RELAY_RUNTIME_SERVICE_ACCOUNT=runtime@example.com

# 边缘容器监听的宿主机端口，也就是网关反代的目标。
EDGE_INTERNAL_PORT=18080

# relay 的区域标签，仅用于区域偏好提示，单节点部署可以不动。
ORCA_RELAY_REGION=us-central1

# 换密钥时注意：auth 的 ES256 签名私钥在 data/auth 里，丢了 relay 缓存的 JWKS 会失配。
# 这两个值故意留空：compose 会在变量为空时报错，逼着部署人填真值，而不是带着占位符上线。
ORCA_AUTH_SESSION_COOKIE_SECRET=
ORCA_RELAY_ASSIGNMENT_SIGNING_KEY=

# 走 PostgreSQL 时填这一行；留空即用 SQLite（文件在 data/auth/orca-auth.sqlite）。
# ORCA_AUTH_DATABASE_URL=postgres://orca:orca@postgres:5432/orca_auth
